{
  "name": "qbtsync",
  "version": "1.0.0",
  "description": "QuickBooks Time sync service for time_records",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "QBT_ENV=dev nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "start": "node dist/index.js",
    "migrate": "ts-node src/index.ts --full-import",
    "reset": "ts-node src/index.ts --reset",
    "wipe": "ts-node src/index.ts --reset"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mongodb": "^6.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
