MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=your_database_name_here
MOCK_QBT_DB_NAME=mock_qbt
QBT_ACCESS_TOKEN=your_quickbooks_time_access_token_here
QBT_ENV=prod
TIMESHEET_START_DATE=2024-01-01
# Base tick of the single sequential sync loop.
TIMESHEET_SYNC_INTERVAL_MS=60000
# Reconcile users+jobcodes every Nth tick (1 = every tick).
ENTITY_SYNC_EVERY_N_TICKS=1
# How often the full qbt-object-map cleanup runs (wall-clock). Default 7 days.
MAPPING_CLEANUP_INTERVAL_MS=604800000
# Pad (ms) for clock skew between our host and QBT when advancing the inbound
# timesheet cursor. Keep small relative to TIMESHEET_SYNC_INTERVAL_MS — a larger
# value just causes redundant (idempotent) re-fetches.
QBT_CLOCK_SKEW_PAD_MS=5000
# Self-throttle outbound QBT API calls below the plan's hard limit (300 req / 5
# min on live). Sliding window across all four HTTP verbs; default leaves
# headroom. Lower the cap or widen the window if QBT changes the limit.
QBT_RATE_LIMIT_MAX_REQUESTS=260
QBT_RATE_LIMIT_WINDOW_MS=300000

# Outbound timesheet sync processes changed time_records in batches of this many,
# sorted by last_update.on, instead of loading the whole changed set at once (the
# first run's changed set is the entire collection and OOMs the heap). Cursor saves
# per batch. Requires a Mongo index on time_records {"last_update.on": 1}.
OUTBOUND_TS_BATCH_SIZE=250
