MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=your_database_name_here
MOCK_QBT_DB_NAME=mock_qbt
QBT_ACCESS_TOKEN=your_quickbooks_time_access_token_here
QBT_ENV=prod
TIMESHEET_START_DATE=2024-01-01
# Base tick of the single sequential sync loop.
TIMESHEET_SYNC_INTERVAL_MS=60000
# Reconcile users+jobcodes every Nth tick (1 = every tick).
ENTITY_SYNC_EVERY_N_TICKS=1
# Pad (ms) for clock skew between our host and QBT when advancing the inbound
# timesheet cursor. Keep small relative to TIMESHEET_SYNC_INTERVAL_MS — a larger
# value just causes redundant (idempotent) re-fetches.
QBT_CLOCK_SKEW_PAD_MS=5000
