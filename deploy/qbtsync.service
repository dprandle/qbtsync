[Unit]
Description=qbtsync — QuickBooks Time <-> UberMail MongoDB sync service
Documentation=https://github.com/dprandle/qbtsync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Dedicated unprivileged account. Create once with:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin qbtsync
User=qbtsync
Group=qbtsync

# Where the built code lives (contains dist/, node_modules/).
WorkingDirectory=/opt/qbtsync
ExecStart=/usr/bin/node dist/index.js

# Config + secrets (MONGODB_URI, QBT_ACCESS_TOKEN, etc.) live here, not in the
# unit. Create /etc/qbtsync/qbtsync.env (chmod 600, owned by qbtsync) from
# .env.example. The leading '-' makes the file optional so the service still
# starts if everything is supplied another way.
EnvironmentFile=-/etc/qbtsync/qbtsync.env

# systemd creates and owns /var/lib/qbtsync (mode 0750) and keeps it across
# restarts/redeploys. Point the persisted cursor/bootstrap state at it so a
# moved working directory never replays the full timesheet import.
StateDirectory=qbtsync
Environment=SYNC_STATE_FILE=/var/lib/qbtsync/sync_state.json

# Restart on crash; don't hammer on a hard config failure.
Restart=on-failure
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=5

# Logs to the journal: journalctl -u qbtsync -f
StandardOutput=journal
StandardError=journal

# --- Basic hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# StateDirectory is writable automatically; nothing else needs to be.
ReadWritePaths=/var/lib/qbtsync
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
